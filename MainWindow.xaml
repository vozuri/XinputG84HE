                            Command="{Binding StartBindCommand}" CommandParameter="{x:Static models:ControllerInput.X}">
                        <ui:Button.Background>
                            <MultiBinding Converter="{StaticResource DigitalBrush}" ConverterParameter="{x:Static models:ControllerInput.X}">
                                <Binding Path="XLabel" /><Binding Path="PressedInputs" />
