                        <StackPanel>
                            <TextBlock Text="X" Style="{StaticResource HotspotGlyph}" FontSize="16" />
                            <TextBlock Text="{Binding XLabel}" Style="{StaticResource HotspotLabel}" Visibility="{Binding XLabel, Converter={StaticResource LabelVisibility}}" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource HotspotStyle}" Width="50" Height="50" Canvas.Left="605" Canvas.Top="208" CornerRadius="25"
