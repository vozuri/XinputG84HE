<ui:FluentWindow x:Class="XinputG84HE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:conv="clr-namespace:XinputG84HE.Converters"
        xmlns:models="clr-namespace:XinputG84HE.Models"
        Title="EPOMAKER G84HE Xbox Emulation"
        Height="900" Width="1600" MinHeight="700" MinWidth="1000"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Closing="OnWindowClosing">

    <ui:FluentWindow.Resources>
        <conv:BoolToTextConverter x:Key="ConnectedText" TrueText="G84HE Connected" FalseText="G84HE Disconnected" />
        <conv:BoolToTextConverter x:Key="EmuText" TrueText="Emulation On" FalseText="Emulation Off" />
        <conv:BoolToBrushConverter x:Key="DotBrush" TrueBrush="#4CAF7D" FalseBrush="#C0392B" />
        <conv:BoolToBrushConverter x:Key="SwitchBrush" TrueBrush="#3300C896" FalseBrush="#33C0392B" />
        <conv:PercentFormatConverter x:Key="PercentFormat" />
        <conv:BoolToVisibilityConverter x:Key="BindingVisibility" />
        <conv:BoolToVisibilityConverter x:Key="InvertedVisibility" Invert="True" />
        <conv:PressedInputsToBrushConverter x:Key="PressedBrush" PressedBrush="#00C896" IdleBrush="#22FFFFFF" />
        <conv:LabelToBoundBrushConverter x:Key="AnalogBoundBrush" UnboundBrush="#332B1414" BoundBrush="#2200C896" />
        <conv:LabelToVisibilityConverter x:Key="LabelVisibility" />
        <conv:BoundPressedMultiConverter x:Key="DigitalBrush" UnboundBrush="#332B1414" BoundIdleBrush="#2200C896" PressedBrush="#00C896" />
        <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountVisibility" />

        <Style x:Key="HotspotStyle" TargetType="ui:Button">
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="10" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00C896" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HotspotGlyph" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HotspotLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Opacity" Value="0.8" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="64" />
        </Style>

        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="12" Background="{TemplateBinding Background}" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Grid>
                                <Ellipse x:Name="Knob" Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="3,0,0,0" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,3,0" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconActionButton" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#22FFFFFF" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00C896" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="#14000000" Padding="20,44,20,20">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel>
                    <Grid Margin="0,0,0,20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="EPOMAKER G84HE" FontSize="19" FontWeight="Bold" />
                            <TextBlock Text="Xbox Emulation" FontSize="13" Opacity="0.65" />
                        </StackPanel>
                        <Button Grid.Column="1" Content="Exit" Click="OnExitClick" VerticalAlignment="Top"
                                Padding="10,5" FontSize="11" Background="#33C0392B" Foreground="White" BorderThickness="0" />
                    </Grid>

                    <!-- Connection status -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                        <Ellipse Width="10" Height="10" Fill="{Binding IsKeyboardConnected, Converter={StaticResource DotBrush}}" VerticalAlignment="Center" />
                        <TextBlock Text="{Binding IsKeyboardConnected, Converter={StaticResource ConnectedText}}" Margin="8,0,0,0" FontSize="12" VerticalAlignment="Center" />
                        <Button Content="?" Command="{Binding ToggleAnalogHelpCommand}" Padding="7,0" Margin="8,0,0,0" FontSize="11" FontWeight="Bold" />
                    </StackPanel>
                    <StackPanel Margin="0,4,0,12" Visibility="{Binding IsAnalogHelpVisible, Converter={StaticResource BindingVisibility}}">
                        <Button Content="Force Analog Input" Command="{Binding InitializeAnalogModeCommand}" Padding="0,8" HorizontalContentAlignment="Center" Margin="0,0,0,4" />
                        <TextBlock Text="Runs automatically on startup and when emulation turns on - use this if the keyboard ever comes up silent." FontSize="10" Opacity="0.55" TextWrapping="Wrap" />
                    </StackPanel>

                    <!-- Emulation toggle -->
                    <Button Command="{Binding ToggleEmulationCommand}" Height="52" Margin="0,0,0,4">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#2A2D3A" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FontSize" Value="15" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmulationRunning}" Value="True">
                                        <Setter Property="Background" Value="#00C896" />
                                        <Setter Property="Foreground" Value="#0B0F0D" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPendingStop}" Value="True">
                                        <Setter Property="Background" Value="#D9A441" />
                                        <Setter Property="Foreground" Value="#0B0F0D" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding IsEmulationRunning, Converter={StaticResource EmuText}}" />
                    </Button>
                    <TextBlock Text="Waiting for held keys to release..." FontSize="10" Opacity="0.6" Margin="0,0,0,14"
                               Visibility="{Binding IsPendingStop, Converter={StaticResource BindingVisibility}}" />

                    <!-- Presets -->
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PRESETS" FontSize="10" Opacity="0.55" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="+" Style="{StaticResource IconActionButton}" ToolTip="New preset" Command="{Binding NewPresetCommand}" Margin="0,0,6,0" FontWeight="Bold" FontSize="18" />
                            <Button Content="&#128190;" Style="{StaticResource IconActionButton}" ToolTip="Save preset" Command="{Binding SavePresetCommand}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding PresetTiles}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="126" Height="70" Margin="0,0,8,8" CornerRadius="10" Padding="8"
                                        MouseLeftButtonUp="OnPresetTileClick"
                                        MouseRightButtonUp="OnPresetTileRightClick">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#1AFFFFFF" />
                                            <Setter Property="BorderBrush" Value="#22FFFFFF" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#2A00C896" />
                                                    <Setter Property="BorderBrush" Value="#00C896" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold"
                                                       TextWrapping="Wrap" VerticalAlignment="Top"
                                                       Visibility="{Binding IsEditingName, Converter={StaticResource InvertedVisibility}}" />
                                            <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12" VerticalAlignment="Top"
                                                     KeyDown="OnPresetRenameKeyDown"
                                                     LostFocus="OnPresetRenameLostFocus"
                                                     Visibility="{Binding IsEditingName, Converter={StaticResource BindingVisibility}}" />
                                        </Grid>

                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right">
                                            <Button Content="&#9998;" ToolTip="Rename" Command="{Binding BeginRenameCommand}"
                                                    FontSize="11" Padding="5,2" Margin="0,0,4,0" />
                                            <Button ToolTip="Lock/unlock" Command="{Binding ToggleLockCommand}"
                                                    FontSize="11" Padding="5,2" Margin="0,0,4,0">
                                                <Button.Style>
                                                    <Style TargetType="Button">
                                                        <Setter Property="Content" Value="&#128275;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                <Setter Property="Content" Value="&#128274;" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="&#10005;" ToolTip="Delete" Command="{Binding DeleteCommand}"
                                                    FontSize="11" Padding="5,2" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Tuning -->
                    <TextBlock Text="ANALOG DEADZONE" FontSize="10" Opacity="0.55" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="0" Maximum="30" Value="{Binding DeadzonePercent}" />
                        <TextBlock Grid.Column="1" Text="{Binding DeadzonePercent, Converter={StaticResource PercentFormat}}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" />
                    </Grid>

                    <TextBlock Text="DIGITAL DEADZONE" FontSize="10" Opacity="0.55" Margin="0,0,0,4" />
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="40" />
                        </Grid.ColumnDefinitions>
                        <Slider Minimum="10" Maximum="90" Value="{Binding DigitalThresholdPercent}" />
                        <TextBlock Grid.Column="1" Text="{Binding DigitalThresholdPercent, Converter={StaticResource PercentFormat}}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" />
                    </Grid>

                    <!-- Switches -->
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Block mapped keys while active" VerticalAlignment="Center" FontSize="12" TextWrapping="Wrap" />
                        <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding BlockMappedKeys}"
                                      Click="OnBlockMappedKeysClick"
                                      Background="{Binding BlockMappedKeys, Converter={StaticResource SwitchBrush}}" VerticalAlignment="Center" Margin="8,0,0,0" />
                    </Grid>

                    <Border Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Anti Ghost Input" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" />
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding AntiGhostInputEnabled}"
                                              Background="{Binding AntiGhostInputEnabled, Converter={StaticResource SwitchBrush}}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Text="Ignores a key stuck reporting the same non-max value for too long." FontSize="10" Opacity="0.55" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="40" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="10" Value="{Binding AntiGhostInputSeconds}" IsEnabled="{Binding AntiGhostInputEnabled}" />
                                <TextBlock Grid.Column="1" Text="{Binding AntiGhostInputSeconds, StringFormat={}{0:0.0}s}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Hotkeys -->
                    <Expander Header="Hotkey Configuration" IsExpanded="{Binding IsHotkeysExpanded}" Margin="0,0,0,16">
                        <StackPanel Margin="0,10,0,0">
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Opacity="0.8">
                                    <Run Text="Toggle emulation: " /><Run Text="{Binding ToggleHotkeyText}" FontWeight="SemiBold" />
                                </TextBlock>
                                <Button Grid.Column="1" Content="Change" Command="{Binding SetToggleHotkeyCommand}" Padding="8,3" FontSize="11" />
                            </Grid>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Opacity="0.8">
                                    <Run Text="Next preset: " /><Run Text="{Binding NextPresetHotkeyText}" FontWeight="SemiBold" />
                                </TextBlock>
                                <Button Grid.Column="1" Content="Change" Command="{Binding SetNextPresetHotkeyCommand}" Padding="8,3" FontSize="11" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="11" Opacity="0.8">
                                    <Run Text="Previous preset: " /><Run Text="{Binding PrevPresetHotkeyText}" FontWeight="SemiBold" />
                                </TextBlock>
                                <Button Grid.Column="1" Content="Change" Command="{Binding SetPrevPresetHotkeyCommand}" Padding="8,3" FontSize="11" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- Live key actuation -->
                    <TextBlock Text="LIVE KEY ACTUATION" FontSize="10" Opacity="0.55" Margin="0,0,0,6" />
                    <ItemsControl ItemsSource="{Binding ActiveKeyRows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Vertical" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,0,0,6" Padding="8,6" CornerRadius="8" Background="#22FFFFFF">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="{Binding Label}" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Left" />
                                            <TextBlock Text="{Binding Percent, StringFormat={}{0:0}%}" FontSize="10" Opacity="0.7" HorizontalAlignment="Right" />
                                        </Grid>
                                        <ProgressBar Minimum="0" Maximum="100" Value="{Binding Percent, Mode=OneWay}" Height="6" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="(no keys currently active)" FontSize="11" Opacity="0.5"
                               Visibility="{Binding ActiveKeyRows.Count, Converter={StaticResource ZeroCountVisibility}}" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== Main content ===================== -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="44" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <ui:TitleBar Grid.Row="0" Title="EPOMAKER G84HE Xbox Emulation" ShowMaximize="True" ShowMinimize="True" />

            <Border Grid.Row="1" Margin="24,10,24,0" Padding="14,10" CornerRadius="10" Background="#1E00C896"
                    Visibility="{Binding IsBinding, Converter={StaticResource BindingVisibility}}">
                <TextBlock Text="{Binding BindingStatusText}" FontSize="13" FontWeight="SemiBold" />
            </Border>

            <Border Grid.Row="1" Margin="24,10,24,0" Padding="14,10" CornerRadius="10" Background="#1E3B82F6"
                    Visibility="{Binding IsCapturingHotkey, Converter={StaticResource BindingVisibility}}">
                <TextBlock Text="Press the key combo you want to use..." FontSize="13" FontWeight="SemiBold" />
            </Border>

            <Viewbox Grid.Row="2" Stretch="Uniform" Margin="24,10">
                <Canvas Width="780" Height="500" Background="Transparent" MouseRightButtonDown="OnCanvasRightClick">

                    <!-- Body backdrop -->
                    <Border Canvas.Left="20" Canvas.Top="90" Width="740" Height="400" CornerRadius="75"
                            Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" />

                    <!-- Trigger/bumper grouping boxes -->
                    <Border Canvas.Left="94" Canvas.Top="0" Width="102" Height="78" CornerRadius="20"
                            Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" />
                    <Border Canvas.Left="584" Canvas.Top="0" Width="102" Height="78" CornerRadius="20"
                            Background="#14FFFFFF" BorderBrush="#22FFFFFF" BorderThickness="1" />

                    <!-- Triggers -->
                    <ui:Button Style="{StaticResource HotspotStyle}" Width="90" Height="28" Canvas.Left="100" Canvas.Top="4"
                            Background="{Binding LeftTriggerLabel, Converter={StaticResource AnalogBoundBrush}}"
                            Command="{Binding StartBindCommand}" CommandParameter="{x:Static models:ControllerInput.LeftTrigger}">
                        <StackPanel>
                            <TextBlock Text="LT" Style="{StaticResource HotspotGlyph}" />
                            <TextBlock Text="{Binding LeftTriggerLabel}" Style="{StaticResource HotspotLabel}"
                                       Visibility="{Binding LeftTriggerLabel, Converter={StaticResource LabelVisibility}}" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource HotspotStyle}" Width="90" Height="28" Canvas.Left="590" Canvas.Top="4"
                            Background="{Binding RightTriggerLabel, Converter={StaticResource AnalogBoundBrush}}"
                            Command="{Binding StartBindCommand}" CommandParameter="{x:Static models:ControllerInput.RightTrigger}">
                        <StackPanel>
                            <TextBlock Text="RT" Style="{StaticResource HotspotGlyph}" />
                            <TextBlock Text="{Binding RightTriggerLabel}" Style="{StaticResource HotspotLabel}"
                                       Visibility="{Binding RightTriggerLabel, Converter={StaticResource LabelVisibility}}" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Bumpers -->
                    <ui:Button Style="{StaticResource HotspotStyle}" Width="90" Height="28" Canvas.Left="100" Canvas.Top="44"
                            Command="{Binding StartBindCommand}" CommandParameter="{x:Static models:ControllerInput.LeftBumper}">
                        <ui:Button.Background>
                            <MultiBinding Converter="{StaticResource DigitalBrush}" ConverterParameter="{x:Static models:ControllerInput.LeftBumper}">
                                <Binding Path="LeftBumperLabel" /><Binding Path="PressedInputs" />
                            </MultiBinding>
                        </ui:Button.Background>
                        <StackPanel>
                            <TextBlock Text="LB" Style="{StaticResource HotspotGlyph}" />
                            <TextBlock Text="{Binding LeftBumperLabel}" Style="{StaticResource HotspotLabel}"
                                       Visibility="{Binding LeftBumperLabel, Converter={StaticResource LabelVisibility}}" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource HotspotStyle}" Width="90" Height="28" Canvas.Left="590" Canvas.Top="44"
                            Command="{Binding StartBindCommand}" CommandParameter="{x:Static models:ControllerInput.RightBumper}">
                        <ui:Button.Background>
                            <MultiBinding Converter="{StaticResource DigitalBrush}" ConverterParameter="{x:Static models:ControllerInput.RightBumper}">
                                <Binding Path="RightBumperLabel" /><Binding Path="PressedInputs" />
                            </MultiBinding>
                        </ui:Button.Background>
                        <StackPanel>
                            <TextBlock Text="RB" Style="{StaticResource HotspotGlyph}" />
                            <TextBlock Text="{Binding RightBumperLabel}" Style="{StaticResource HotspotLabel}"
                                       Visibility="{Binding RightBumperLabel, Converter={StaticResource LabelVisibility}}" />
                        </StackPanel>
                    </ui:Button>

                    <!-- View / Guide / Menu -->
                    <ui:Button Style="{StaticResource HotspotStyle}" Width="60" Height="32" Canvas.Left="310" Canvas.Top="130" CornerRadius="16"
                            Command="{Binding StartBindCommand}" CommandParameter="{x:Static models:ControllerInput.Back}">
                        <ui:Button.Background>
                            <MultiBinding Converter="{StaticResource DigitalBrush}" ConverterParameter="{x:Static models:ControllerInput.Back}">
                                <Binding Path="BackLabel" /><Binding Path="PressedInputs" />
                            </MultiBinding>
                        </ui:Button.Background>
                        <StackPanel>
                            <TextBlock Text="View" Style="{StaticResource HotspotGlyph}" FontSize="11" />
                            <TextBlock Text="{Binding BackLabel}" Style="{StaticResource HotspotLabel}"
                                       Visibility="{Binding BackLabel, Converter={StaticResource LabelVisibility}}" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource HotspotStyle}" Width="44" Height="32" Canvas.Left="374" Canvas.Top="130" CornerRadius="16"
                            Command="{Binding StartBindCommand}" CommandParameter="{x:Static models:ControllerInput.Guide}">
                        <ui:Button.Background>
                            <MultiBinding Converter="{StaticResource DigitalBrush}" ConverterParameter="{x:Static models:ControllerInput.Guide}">
                                <Binding Path="GuideLabel" /><Binding Path="PressedInputs" />
                            </MultiBinding>
                        </ui:Button.Background>
                        <StackPanel>
                            <TextBlock Text="Xbox" Style="{StaticResource HotspotGlyph}" FontSize="10" />
                            <TextBlock Text="{Binding GuideLabel}" Style="{StaticResource HotspotLabel}"
                                       Visibility="{Binding GuideLabel, Converter={StaticResource LabelVisibility}}" />
                        </StackPanel>
                    </ui:Button>
                    <ui:Button Style="{StaticResource HotspotStyle}" Width="60" Height="32" Canvas.Left="422" Canvas.Top="130" CornerRadius="16"
                            Command="{Binding StartBindCommand}" CommandParameter="{x:Static models:ControllerInput.Start}">
                        <ui:Button.Background>
                            <MultiBinding Converter="{StaticResource DigitalBrush}" ConverterParameter="{x:Static models:ControllerInput.Start}">
                                <Binding Path="StartLabel" /><Binding Path="PressedInputs" />
                            </MultiBinding>
                        </ui:Button.Background>
                        <StackPanel>
                            <TextBlock Text="Menu" Style="{StaticResource HotspotGlyph}" FontSize="11" />
                            <TextBlock Text="{Binding StartLabel}" Style="{StaticResource HotspotLabel}"
                                       Visibility="{Binding StartLabel, Converter={StaticResource LabelVisibility}}" />
                        </StackPanel>
                    </ui:Button>

                    <!-- Left stick (center 200,250) -->
                    <Ellipse Canvas.Left="152" Canvas.Top="202" Width="96" Height="96" Fill="#14FFFFFF" Stroke="#33FFFFFF" StrokeThickness="1" />
