                        <TextBlock Text="&#9654;" Style="{StaticResource HotspotGlyph}" />
                    </ui:Button>

                </Canvas>
            </Viewbox>

            <!-- Physical keyboard actuation, directly below the controller. -->
            <Viewbox Grid.Row="3" Stretch="Uniform" Margin="24,0,24,10" MouseRightButtonDown="OnCanvasRightClick">
                <Border Width="780" Padding="17" CornerRadius="12" Background="#0E121C" BorderBrush="#2AFFFFFF" BorderThickness="1">
                    <StackPanel>
                        <Grid Margin="0,0,0,12">
                            <TextBlock Text="LIVE KEY ACTUATION" FontSize="10" FontWeight="Bold" Foreground="#00C896" />
                        </Grid>
                        <ItemsControl ItemsSource="{Binding KeyboardKeys}" Width="{x:Static models:KeyboardLayout.Width}" Height="{x:Static models:KeyboardLayout.Height}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <Canvas />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemContainerStyle>
                                <Style TargetType="ContentPresenter">
                                    <Setter Property="Canvas.Left" Value="{Binding Key.X}" />
                                    <Setter Property="Canvas.Top" Value="{Binding Key.Y}" />
                                </Style>
                            </ItemsControl.ItemContainerStyle>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Button Width="{Binding Key.Width}" Height="{Binding Key.Height}" Style="{StaticResource KeyboardKeyStyle}"
                                            Command="{Binding DataContext.SelectKeyboardKeyCommand, RelativeSource={RelativeSource AncestorType=ItemsControl}}"
                                            CommandParameter="{Binding}"
                                            Background="{Binding Percent, Converter={StaticResource KeyActuationBrush}}"
                                            ToolTip="{Binding ActuationText}" ToolTipService.ShowOnDisabled="True"
                                            AutomationProperties.Name="{Binding ActuationText}">
                                        <TextBlock Text="{Binding Key.Label}" FontSize="11" FontWeight="SemiBold"
                                                   Foreground="{Binding Percent, Converter={StaticResource KeyActuationBrush}, ConverterParameter=Label}"
                                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Button>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Viewbox>

            <TextBlock Grid.Row="4" Text="App Version 1.12 Designed by Claude Sonnet 5, Gemini 3.6 Flash and ChatGPT 6 Astra"
                       FontSize="11" Opacity="0.4" TextWrapping="Wrap" TextAlignment="Center"
                       HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,8"
                       IsHitTestVisible="False" />
        </Grid>

        <!-- ===================== Curve Editor Overlay ===================== -->
        <Grid Grid.ColumnSpan="2" Background="#D80B0F0D" Visibility="{Binding IsCurveEditorVisible, Converter={StaticResource BindingVisibility}}" Panel.ZIndex="100">
            <Border Background="#14171E" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="16" 
                    Width="760" Height="580" HorizontalAlignment="Center" VerticalAlignment="Center" Padding="24">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Row 0: Header & Joystick Selector -->
                    <Grid Grid.Row="0" Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <TextBlock Text="{Binding CurveEditorTitle}" FontSize="20" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Drag control points on graph or enter exact values below to modify response." FontSize="11" Opacity="0.6" Margin="0,2,0,0" />
                        </StackPanel>

                        <!-- Joystick Selector Tabs -->
                        <Border Grid.Column="1" Background="#1AFFFFFF" CornerRadius="8" Padding="3" VerticalAlignment="Center" Margin="16,0,16,0">
                            <StackPanel Orientation="Horizontal">
                                <Button Content="Left Stick" Padding="12,6" FontSize="12" FontWeight="SemiBold"
                                        Command="{Binding SelectJoystickCommand}" CommandParameter="0">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurveEditorJoystick}" Value="0">
                                                    <Setter Property="Background" Value="#00C896" />
                                                    <Setter Property="Foreground" Value="#0B0F0D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Right Stick" Padding="12,6" FontSize="12" FontWeight="SemiBold"
                                        Command="{Binding SelectJoystickCommand}" CommandParameter="1">
                                    <Button.Style>
                                        <Style TargetType="Button">
                                            <Setter Property="Background" Value="Transparent" />
                                            <Setter Property="Foreground" Value="White" />
                                            <Setter Property="BorderThickness" Value="0" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="Button">
                                                        <Border Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                                        </Border>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding CurveEditorJoystick}" Value="1">
                                                    <Setter Property="Background" Value="#00C896" />
                                                    <Setter Property="Foreground" Value="#0B0F0D" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!-- Close Button -->
                        <Button Grid.Column="2" Content="&#10005;" Command="{Binding CloseCurveEditorCommand}"
                                Width="32" Height="32" FontSize="14" Foreground="White" Background="#22FFFFFF"
                                BorderThickness="0" Cursor="Hand" VerticalAlignment="Center">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="16">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </Grid>

                    <!-- Row 1: Preset Actions -->
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,12">
                        <StackPanel.Resources>
                            <Style x:Key="PresetButtonStyle" TargetType="Button">
                                <Setter Property="Background" Value="#22FFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderThickness" Value="0" />
                                <Setter Property="Padding" Value="10,5" />
                                <Setter Property="FontSize" Value="11" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="Margin" Value="0,0,6,0" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="6" Padding="{TemplateBinding Padding}">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </StackPanel.Resources>
                        <TextBlock Text="Presets:" FontSize="12" Opacity="0.6" VerticalAlignment="Center" Margin="0,0,10,0" />
                        <Button Content="Linear (1:1)" Command="{Binding ApplyLinearCurveCommand}" Style="{StaticResource PresetButtonStyle}" />
                        <Button Content="S-Curve (Soft)" Command="{Binding ApplySCurveCommand}" Style="{StaticResource PresetButtonStyle}" />
                        <Button Content="Aggressive" Command="{Binding ApplyAggressiveCurveCommand}" Style="{StaticResource PresetButtonStyle}" />
                        <Button Content="Smooth / Delay" Command="{Binding ApplySmoothCurveCommand}" Style="{StaticResource PresetButtonStyle}" />
                        <Button Content="Reset Default" Command="{Binding ResetCurveCommand}" Style="{StaticResource PresetButtonStyle}" Margin="0" />
                    </StackPanel>

                    <!-- Row 2: Graph Canvas -->
                    <Border Grid.Row="2" Background="#0C0F17" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,0,0,14">
                        <Canvas x:Name="GraphCanvas" Background="Transparent" ClipToBounds="True"
                                MouseDown="OnGraphCanvasMouseDown"
                                MouseMove="OnGraphCanvasMouseMove"
                                MouseUp="OnGraphCanvasMouseUp"
                                MouseLeave="OnGraphCanvasMouseLeave"
                                SizeChanged="OnGraphCanvasSizeChanged"
                                Cursor="Cross" />
                    </Border>

                    <!-- Row 3: Exact Values Table -->
                    <Border Grid.Row="3" Background="#0C0F17" BorderBrush="#22FFFFFF" BorderThickness="1" CornerRadius="10" Padding="10,8" Margin="0,0,0,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,6">
                                <TextBlock Text="Exact Values Table (Virtual Output %)" FontSize="11" FontWeight="SemiBold" Foreground="#00C896" />
                                <TextBlock Text="Physical Actuation Input %" FontSize="10" Opacity="0.5" HorizontalAlignment="Right" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding CurvePoints}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="11" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="2,0">
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <TextBlock Grid.Row="0" Text="{Binding X, StringFormat={}{0}%}" FontSize="10" Opacity="0.6" HorizontalAlignment="Center" Margin="0,0,0,2" />
                                            <Border Grid.Row="1" Background="#1AFFFFFF" BorderBrush="#33FFFFFF" BorderThickness="1" CornerRadius="4">
                                                <TextBox Text="{Binding Y, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:0}}" 
                                                         FontSize="11" FontWeight="SemiBold" TextAlignment="Center" Padding="2,3"
                                                         Background="Transparent" Foreground="White" BorderThickness="0" />
                                            </Border>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </Border>

                    <!-- Row 4: Footer Actions -->
                    <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Content="Done" Command="{Binding CloseCurveEditorCommand}" 
                                Background="#00C896" Foreground="#0B0F0D" FontWeight="Bold" FontSize="13" Padding="28,8" Cursor="Hand">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#00E6AD" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>

        <!-- ===================== Tray icon ===================== -->
        <tb:TaskbarIcon x:Name="TrayIcon"
                         IconSource="pack://application:,,,/Assets/icon.ico"
                         ToolTipText="EPOMAKER G84HE Xbox Emulation"
                         MenuActivation="LeftOrRightClick"
                         TrayLeftMouseUp="OnTrayLeftClick">
            <tb:TaskbarIcon.ContextMenu>
                <ContextMenu>
                    <MenuItem Header="Show" Click="OnTrayShow" />
                    <MenuItem Header="Toggle Emulation" Click="OnTrayToggleEmulation" />
                    <Separator />
                    <MenuItem Header="Exit" Click="OnTrayExit" />
                </ContextMenu>
            </tb:TaskbarIcon.ContextMenu>
        </tb:TaskbarIcon>
    </Grid>
</ui:FluentWindow>
