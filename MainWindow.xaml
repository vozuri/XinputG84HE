<ui:FluentWindow x:Class="XinputG84HE.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
        xmlns:tb="clr-namespace:H.NotifyIcon;assembly=H.NotifyIcon.Wpf"
        xmlns:conv="clr-namespace:XinputG84HE.Converters"
        xmlns:models="clr-namespace:XinputG84HE.Models"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="EPOMAKER G84HE Xbox Emulation"
        Icon="pack://application:,,,/Assets/icon.ico"
        Height="1130" Width="1600" MinHeight="840" MinWidth="1000"
        WindowBackdropType="Mica"
        ExtendsContentIntoTitleBar="True"
        Closing="OnWindowClosing">

    <ui:FluentWindow.Resources>
        <conv:BoolToTextConverter x:Key="ConnectedText" TrueText="G84HE Connected" FalseText="G84HE Disconnected" />
        <conv:BoolToTextConverter x:Key="EmuText" TrueText="Emulation Active" FalseText="Start Emulation" />
        <conv:BoolToBrushConverter x:Key="DotBrush" TrueBrush="#00C896" FalseBrush="#E74C3C" />
        <conv:BoolToBrushConverter x:Key="SwitchBrush" TrueBrush="#00C896" FalseBrush="#2A303C" />
        <conv:PercentFormatConverter x:Key="PercentFormat" />
        <conv:BoolToVisibilityConverter x:Key="BindingVisibility" />
        <conv:BoolToVisibilityConverter x:Key="InvertedVisibility" Invert="True" />
        <conv:PressedInputsToBrushConverter x:Key="PressedBrush" PressedBrush="#00C896" IdleBrush="#1AFFFFFF" />
        <conv:LabelToBoundBrushConverter x:Key="AnalogBoundBrush" UnboundBrush="#221A1D24" BoundBrush="#2500C896" />
        <conv:LabelToVisibilityConverter x:Key="LabelVisibility" />
        <conv:BoundPressedMultiConverter x:Key="DigitalBrush" UnboundBrush="#221A1D24" BoundIdleBrush="#2500C896" PressedBrush="#00C896" />
        <conv:ZeroCountToVisibilityConverter x:Key="ZeroCountVisibility" />
        <conv:KeyActuationBrushConverter x:Key="KeyActuationBrush" />

        <Style x:Key="KeyboardKeyStyle" TargetType="Button">
            <Setter Property="BorderBrush" Value="#35404D" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="5" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                Padding="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#A5B5C4" />
                </Trigger>
                <DataTrigger Binding="{Binding IsMapped}" Value="True">
                    <Setter Property="BorderBrush" Value="#66F5CB" />
                    <Setter Property="BorderThickness" Value="2" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter Property="BorderBrush" Value="#79B8FF" />
                    <Setter Property="BorderThickness" Value="3" />
                </DataTrigger>
                <DataTrigger Binding="{Binding DataContext.IsCurrentPresetLocked, RelativeSource={RelativeSource AncestorType=ItemsControl}}" Value="True">
                    <Setter Property="IsEnabled" Value="False" />
                    <Setter Property="Cursor" Value="Arrow" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Hotspot Style for Controller Buttons -->
        <Style x:Key="HotspotStyle" TargetType="ui:Button">
            <Setter Property="Background" Value="#1F2430" />
            <Setter Property="BorderBrush" Value="#33FFFFFF" />
            <Setter Property="BorderThickness" Value="1.2" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ui:Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="{TemplateBinding CornerRadius}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00C896" />
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HotspotGlyph" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="HorizontalAlignment" Value="Center" />
        </Style>
        <Style x:Key="HotspotLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="9" />
            <Setter Property="Foreground" Value="#00C896" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="MaxWidth" Value="64" />
        </Style>

        <!-- Modern Toggle Switch -->
        <Style x:Key="SwitchStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="44" />
            <Setter Property="Height" Value="22" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Track" CornerRadius="11" Background="{TemplateBinding Background}" BorderBrush="#33FFFFFF" BorderThickness="1">
                            <Grid>
                                <Ellipse x:Name="Knob" Width="16" Height="16" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                                    <Ellipse.Effect>
                                        <DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.3" />
                                    </Ellipse.Effect>
                                </Ellipse>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Knob" Property="HorizontalAlignment" Value="Right" />
                                <Setter TargetName="Knob" Property="Margin" Value="0,0,2,0" />
                                <Setter TargetName="Track" Property="Background" Value="#00C896" />
                                <Setter TargetName="Track" Property="BorderBrush" Value="#00C896" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconActionButton" TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="BorderBrush" Value="#2AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00C896" />
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Frosted Glass Card Panel -->
        <Style x:Key="GlassPanel" TargetType="Border">
            <Setter Property="Background" Value="#121620" />
            <Setter Property="BorderBrush" Value="#22FFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="12" />
            <Setter Property="Padding" Value="12" />
        </Style>

        <!-- Glass Secondary Button -->
        <Style x:Key="GlassButton" TargetType="Button">
            <Setter Property="Background" Value="#1AFFFFFF" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderBrush" Value="#2AFFFFFF" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="8" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#33FFFFFF" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="#00C896" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </ui:FluentWindow.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="310" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ===================== Sidebar ===================== -->
        <Border Grid.Column="0" Background="#0D111A" BorderBrush="#22FFFFFF" BorderThickness="0,0,1,0" Padding="18,36,18,20">
            <ScrollViewer VerticalScrollBarVisibility="Hidden">
                <StackPanel>
                    <Grid Margin="0,0,0,18">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="EPOMAKER G84HE" FontSize="18" FontWeight="Bold" Foreground="White" />
                            <TextBlock Text="Xbox Emulation" FontSize="12" Foreground="#00C896" FontWeight="SemiBold" />
                        </StackPanel>
                    </Grid>

                    <!-- Connection status -->
                    <Border Style="{StaticResource GlassPanel}" Padding="10" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                    <Ellipse Width="8" Height="8" Fill="{Binding IsKeyboardConnected, Converter={StaticResource DotBrush}}" VerticalAlignment="Center" />
                                    <TextBlock Text="{Binding IsKeyboardConnected, Converter={StaticResource ConnectedText}}" Margin="8,0,0,0" FontSize="12" FontWeight="SemiBold" Foreground="White" VerticalAlignment="Center" />
                                </StackPanel>
                                <Button Content="?" Command="{Binding ToggleAnalogHelpCommand}" HorizontalAlignment="Right" Padding="6,1" FontSize="11" FontWeight="Bold" Style="{StaticResource GlassButton}" />
                            </Grid>
                            <Border Background="#2200C896" BorderBrush="#5500C896" BorderThickness="1" CornerRadius="5"
                                    Padding="7,2" Margin="16,6,0,0" HorizontalAlignment="Left"
                                    Visibility="{Binding IsKeyboardConnected, Converter={StaticResource BindingVisibility}}">
                                <TextBlock Text="{Binding ConnectionTransport}" Foreground="#00C896" FontSize="10" FontWeight="SemiBold" />
                            </Border>
                            <StackPanel Margin="0,8,0,0" Visibility="{Binding IsAnalogHelpVisible, Converter={StaticResource BindingVisibility}}">
                                <Button Content="Force Analog Input" Command="{Binding InitializeAnalogModeCommand}" Style="{StaticResource GlassButton}" Padding="0,6" HorizontalContentAlignment="Center" Margin="0,0,0,6" Foreground="#00C896" />
                                <TextBlock Text="Runs automatically on startup and when emulation turns on - use this if the keyboard ever comes up silent." FontSize="10" Opacity="0.6" TextWrapping="Wrap" Foreground="White" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Emulation toggle -->
                    <Button Command="{Binding ToggleEmulationCommand}" Height="48" Margin="0,0,0,4" Cursor="Hand">
                        <Button.Style>
                            <Style TargetType="Button">
                                <Setter Property="Background" Value="#1AFFFFFF" />
                                <Setter Property="Foreground" Value="White" />
                                <Setter Property="BorderBrush" Value="#2AFFFFFF" />
                                <Setter Property="BorderThickness" Value="1" />
                                <Setter Property="FontSize" Value="14" />
                                <Setter Property="FontWeight" Value="Bold" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="Button">
                                            <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10">
                                                <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                            </Border>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsEmulationRunning}" Value="True">
                                        <Setter Property="Background" Value="#00C896" />
                                        <Setter Property="Foreground" Value="#0B0F0D" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                    <DataTrigger Binding="{Binding IsPendingStop}" Value="True">
                                        <Setter Property="Background" Value="#D9A441" />
                                        <Setter Property="Foreground" Value="#0B0F0D" />
                                        <Setter Property="BorderThickness" Value="0" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                        <TextBlock Text="{Binding IsEmulationRunning, Converter={StaticResource EmuText}}" />
                    </Button>
                    <TextBlock Text="Waiting for held keys to release..." FontSize="10" Foreground="#D9A441" Margin="0,2,0,12" HorizontalAlignment="Center"
                               Visibility="{Binding IsPendingStop, Converter={StaticResource BindingVisibility}}" />

                    <!-- Presets Header -->
                    <Grid Margin="0,8,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="PRESETS" FontSize="10" FontWeight="Bold" Foreground="#00C896" VerticalAlignment="Center" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Content="+" Style="{StaticResource IconActionButton}" ToolTip="New preset" Command="{Binding NewPresetCommand}" Margin="0,0,6,0" FontWeight="Bold" FontSize="16" />
                            <Button Content="&#128190;" Style="{StaticResource IconActionButton}" ToolTip="Save preset" Command="{Binding SavePresetCommand}" />
                        </StackPanel>
                    </Grid>

                    <ItemsControl ItemsSource="{Binding PresetTiles}" Margin="0,0,0,16">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel Orientation="Horizontal" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Width="128" Height="68" Margin="0,0,8,8" CornerRadius="10" Padding="8"
                                        MouseLeftButtonUp="OnPresetTileClick"
                                        MouseRightButtonUp="OnPresetTileRightClick" Cursor="Hand">
                                    <Border.Style>
                                        <Style TargetType="Border">
                                            <Setter Property="Background" Value="#121620" />
                                            <Setter Property="BorderBrush" Value="#22FFFFFF" />
                                            <Setter Property="BorderThickness" Value="1" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter Property="Background" Value="#2500C896" />
                                                    <Setter Property="BorderBrush" Value="#00C896" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Border.Style>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <Grid Grid.Row="0">
                                            <TextBlock Text="{Binding Name}" FontSize="12" FontWeight="SemiBold" Foreground="White"
                                                       TextWrapping="Wrap" VerticalAlignment="Top"
                                                       Visibility="{Binding IsEditingName, Converter={StaticResource InvertedVisibility}}" />
                                            <TextBox Text="{Binding EditBuffer, UpdateSourceTrigger=PropertyChanged}"
                                                     FontSize="12" VerticalAlignment="Top" Foreground="White" Background="#1AFFFFFF" BorderBrush="#00C896"
                                                     KeyDown="OnPresetRenameKeyDown"
                                                     LostFocus="OnPresetRenameLostFocus"
                                                     Visibility="{Binding IsEditingName, Converter={StaticResource BindingVisibility}}" />
                                        </Grid>

                                        <TextBlock Grid.Row="1" Text="Always saved" FontSize="10" Foreground="#00C896"
                                                   ToolTip="Permanent working preset. Selected by mouse; preset hotkeys skip this slot."
                                                   Visibility="{Binding IsAutosave, Converter={StaticResource BindingVisibility}}" />
                                        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right"
                                                    Visibility="{Binding IsAutosave, Converter={StaticResource InvertedVisibility}}">
                                            <Button Content="&#9998;" ToolTip="Rename" Command="{Binding BeginRenameCommand}" Style="{StaticResource GlassButton}"
                                                    FontSize="10" Padding="4,1" Margin="0,0,3,0" />
                                            <Button ToolTip="Lock/unlock" Command="{Binding ToggleLockCommand}"
                                                    FontSize="10" Padding="4,1" Margin="0,0,3,0">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource GlassButton}">
                                                        <Setter Property="Content" Value="&#128275;" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsLocked}" Value="True">
                                                                <Setter Property="Content" Value="&#128274;" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                            <Button Content="&#10005;" ToolTip="Delete" Command="{Binding DeleteCommand}" Style="{StaticResource GlassButton}"
                                                    FontSize="10" Padding="4,1" Foreground="#FF6B6B" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- SnapStick+ -->
                    <Border Style="{StaticResource GlassPanel}" BorderBrush="#5500C896" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Background="#2200C896" CornerRadius="5" Padding="8,4" HorizontalAlignment="Left">
                                    <TextBlock Text="&#x26A1; SnapStick+" Foreground="#00C896" FontSize="12" FontWeight="Bold" />
                                </Border>
                                <ToggleButton Grid.Column="1" IsChecked="{Binding SnapStickEnabled}" VerticalAlignment="Center" Margin="8,0,0,0"
                                              ToolTip="Latest press wins on opposing stick directions. Unlock the preset to change this."
                                              AutomationProperties.Name="SnapStick+">
                                    <ToggleButton.Style>
                                        <Style TargetType="ToggleButton" BasedOn="{StaticResource SwitchStyle}">
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding IsCurrentPresetLocked}" Value="True">
                                                    <Setter Property="IsEnabled" Value="False" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </ToggleButton.Style>
                                </ToggleButton>
                            </Grid>
                            <TextBlock Text="Latest opposing press wins on both sticks. Keeps analog depth; releasing it restores the held direction."
                                       FontSize="10" Opacity="0.6" Foreground="White" TextWrapping="Wrap" Margin="0,7,0,0" />
                        </StackPanel>
                    </Border>

                    <!-- Tuning -->
                    <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="ANALOG DEADZONE" FontSize="10" FontWeight="Bold" Foreground="#00C896" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DeadzonePercent, Converter={StaticResource PercentFormat}}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Grid>
                            <Slider Minimum="0" Maximum="30" Value="{Binding DeadzonePercent}" Margin="0,0,0,10" />

                            <Grid Margin="0,0,0,4">
                                <TextBlock Text="DIGITAL DEADZONE" FontSize="10" FontWeight="Bold" Foreground="#00C896" VerticalAlignment="Center" />
                                <TextBlock Text="{Binding DigitalThresholdPercent, Converter={StaticResource PercentFormat}}" HorizontalAlignment="Right" FontSize="11" FontWeight="Bold" Foreground="White" />
                            </Grid>
                            <Slider Minimum="10" Maximum="90" Value="{Binding DigitalThresholdPercent}" Margin="0,0,0,10" />

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Block mapped keys while active" VerticalAlignment="Center" FontSize="11" Foreground="White" TextWrapping="Wrap" />
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding BlockMappedKeys}"
                                              Click="OnBlockMappedKeysClick" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Deadzone Shape -->
                    <TextBlock Text="DEADZONE SHAPE" FontSize="10" FontWeight="Bold" Foreground="#00C896" Margin="0,0,0,6" />
                    <Grid Margin="0,0,0,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="8" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" CornerRadius="10" Padding="10,8" MouseLeftButtonUp="OnSquareDeadzoneClick" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#121620" />
                                    <Setter Property="BorderBrush" Value="#22FFFFFF" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UseRadialDeadzone}" Value="False">
                                            <Setter Property="Background" Value="#2500C896" />
                                            <Setter Property="BorderBrush" Value="#00C896" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Square" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock Text="Default" FontSize="9" Opacity="0.6" Foreground="White" HorizontalAlignment="Center" Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Grid.Column="2" CornerRadius="10" Padding="10,8" MouseLeftButtonUp="OnCircleDeadzoneClick" Cursor="Hand">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Background" Value="#121620" />
                                    <Setter Property="BorderBrush" Value="#22FFFFFF" />
                                    <Setter Property="BorderThickness" Value="1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding UseRadialDeadzone}" Value="True">
                                            <Setter Property="Background" Value="#2500C896" />
                                            <Setter Property="BorderBrush" Value="#00C896" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel HorizontalAlignment="Center">
                                <TextBlock Text="Circle" FontSize="11" FontWeight="SemiBold" Foreground="White" HorizontalAlignment="Center" />
                                <TextBlock Text="Experimental" FontSize="9" Opacity="0.6" Foreground="White" HorizontalAlignment="Center" Margin="0,1,0,0" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!-- Response Curve Editor Trigger Button -->
                    <TextBlock Text="RESPONSE CURVE" FontSize="10" FontWeight="Bold" Foreground="#00C896" Margin="0,0,0,6" />
                    <Button Content="Open Curve Editor" 
                            Command="{Binding OpenCurveEditorCommand}" CommandParameter="0"
                            Height="40" HorizontalAlignment="Stretch" Margin="0,0,0,14"
                            Background="#00C896" Foreground="#0B0F0D" FontSize="12" FontWeight="Bold" Cursor="Hand">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="10">
                                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#00E6AD" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,14">
                        <StackPanel>
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Anti Ghost Input" VerticalAlignment="Center" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                <ToggleButton Grid.Column="1" Style="{StaticResource SwitchStyle}" IsChecked="{Binding AntiGhostInputEnabled}" VerticalAlignment="Center" Margin="8,0,0,0" />
                            </Grid>
                            <TextBlock Text="Ignores stuck key values held too long." FontSize="10" Opacity="0.6" Foreground="White" TextWrapping="Wrap" Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Slider Minimum="0" Maximum="10" Value="{Binding AntiGhostInputSeconds}" IsEnabled="{Binding AntiGhostInputEnabled}" />
                                <TextBlock Grid.Column="1" Text="{Binding AntiGhostInputSeconds, StringFormat={}{0:0.0}s}" VerticalAlignment="Center" HorizontalAlignment="Right" FontSize="10" FontWeight="SemiBold" Foreground="White" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource GlassPanel}" Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0" VerticalAlignment="Center">
                                <TextBlock Text="Report Rate" FontSize="11" FontWeight="SemiBold" Foreground="White" />
                                <TextBlock Text="Polling rate of virtual Xbox controller" FontSize="10" Opacity="0.6" Foreground="White" TextWrapping="Wrap" Margin="0,1,0,0" />
                            </StackPanel>
                            <ComboBox Grid.Column="1" ItemsSource="{Binding AvailableReportRates}" SelectedItem="{Binding EmulationReportRate}" Width="90" VerticalAlignment="Center" Background="#1AFFFFFF" Foreground="White">
                                <ComboBox.ItemTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding StringFormat={}{0} Hz}" />
                                    </DataTemplate>
                                </ComboBox.ItemTemplate>
                            </ComboBox>
                        </Grid>
                    </Border>

                    <!-- Hotkeys -->
                    <Expander Header="Hotkey Configuration" IsExpanded="{Binding IsHotkeysExpanded}" Margin="0,0,0,14" Foreground="White">
                        <StackPanel Margin="0,8,0,0">
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="White">
                                    <Run Text="Toggle: " /><Run Text="{Binding ToggleHotkeyText}" FontWeight="Bold" Foreground="#00C896" />
                                </TextBlock>
                                <Button Grid.Column="1" Content="Change" Command="{Binding SetToggleHotkeyCommand}" Style="{StaticResource GlassButton}" Padding="6,2" FontSize="10" />
                            </Grid>
                            <Grid Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" VerticalAlignment="Center" FontSize="10" Foreground="White">
                                    <Run Text="Next: " /><Run Text="{Binding NextPresetHotkeyText}" FontWeight="Bold" Foreground="#00C896" />
                                </TextBlock>
                                <Button Grid.Column="1" Content="Change" Command="{Binding SetNextPresetHotkeyCommand}" Style="{StaticResource GlassButton}" Padding="6,2" FontSize="10" />
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
