                                     Foreground="White" BorderBrush="#22FFFFFF" FontSize="10" Padding="6" />
                            <Button Content="Copy diagnostics" Command="{Binding CopyDiagnosticsCommand}"
                                    Style="{StaticResource GlassButton}" Margin="0,8,0,0" />
                        </StackPanel>
                    </Expander>

                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- ===================== Main content ===================== -->
