                            <TextBlock Text="{Binding RightStickClickLabel}" Style="{StaticResource HotspotLabel}"
                                       Visibility="{Binding RightStickClickLabel, Converter={StaticResource LabelVisibility}}" />
                        </StackPanel>
                    </ui:Button>
                    <Ellipse Width="16" Height="16" Fill="#00C896" Canvas.Left="{Binding RightStickDotX}" Canvas.Top="{Binding RightStickDotY}" IsHitTestVisible="False" />

                    <ui:Button Style="{StaticResource HotspotStyle}" Width="34" Height="26" Canvas.Left="563" Canvas.Top="310"
                            Background="{Binding RightStickUpLabel, Converter={StaticResource AnalogBoundBrush}}"
                            Command="{Binding StartBindCommand}" CommandParameter="{x:Static models:ControllerInput.RightStickUp}">
                        <TextBlock Text="&#9650;" Style="{StaticResource HotspotGlyph}" />
                    </ui:Button>
                    <ui:Button Style="{StaticResource HotspotStyle}" Width="34" Height="26" Canvas.Left="563" Canvas.Top="456"
                            Background="{Binding RightStickDownLabel, Converter={StaticResource AnalogBoundBrush}}"
                            Command="{Binding StartBindCommand}" CommandParameter="{x:Static models:ControllerInput.RightStickDown}">
