                                    <Run Text="Prev: " /><Run Text="{Binding PrevPresetHotkeyText}" FontWeight="Bold" Foreground="#00C896" />
                                </TextBlock>
                                <Button Grid.Column="1" Content="Change" Command="{Binding SetPrevPresetHotkeyCommand}" Style="{StaticResource GlassButton}" Padding="6,2" FontSize="10" />
                            </Grid>
                        </StackPanel>
                    </Expander>

                    <!-- Diagnostics -->
                    <Expander Header="Diagnostics" IsExpanded="{Binding IsDiagnosticsExpanded}" Margin="0,0,0,14" Foreground="White">
                        <StackPanel Margin="0,8,0,0">
                            <TextBlock Text="{Binding DiagnosticsText}" FontSize="11" Foreground="White" TextWrapping="Wrap" />
                            <TextBlock Text="Output updates measure the app loop, not game latency. Steady key holds may produce fewer HID reports."
