                    <ui:Button Style="{StaticResource HotspotStyle}" Width="30" Height="32" Canvas.Left="146" Canvas.Top="386"
                            Command="{Binding StartBindCommand}" CommandParameter="{x:Static models:ControllerInput.DpadLeft}">
                        <ui:Button.Background>
                            <MultiBinding Converter="{StaticResource DigitalBrush}" ConverterParameter="{x:Static models:ControllerInput.DpadLeft}">
                                <Binding Path="DpadLeftLabel" /><Binding Path="PressedInputs" />
                            </MultiBinding>
